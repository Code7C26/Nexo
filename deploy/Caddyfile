# Caddy delante de Nexo (hist. §103). Saca y renueva solo el certificado de
# Let's Encrypt, redirige http → https y le pasa todo a Node en 127.0.0.1:3000.
# actualizar.sh lo copia a /etc/caddy/Caddyfile cuando cambia.
{$NEXO_DOMINIO:nexosystem.duckdns.org} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# Solo la app y la API quedan fuera de los buscadores. La portada, los
	# términos y la privacidad no: con noindex, la revisión de Google de la
	# marca (verificacion-google.md) no tomaba la política de privacidad.
	@privado path /app /app/* /api/*
	header @privado X-Robots-Tag "noindex, nofollow"

	reverse_proxy 127.0.0.1:3000
}
