{
  "name": "nexo",
  "private": true,
  "type": "module",
  "description": "Herramientas de desarrollo del repo (lint). La app vive en backend/ y frontend/.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "lint": "node scripts/lint.mjs",
    "test": "npm --prefix backend test",
    "backup": "npm --prefix backend run backup",
    "restaurar-nube": "node --env-file-if-exists=.env scripts/restaurar-nube.mjs",
    "seed": "node scripts/seed.mjs",
    "demo": "node scripts/demo.mjs",
    "verificar-migracion": "node scripts/verificar-migracion.mjs",
    "regresion": "node scripts/regresion-head.mjs",
    "fuentes": "node scripts/fuentes.mjs",
    "plan": "node scripts/plan.mjs",
    "probar-mail": "node --env-file-if-exists=.env scripts/probar-mail.mjs",
    "probar-ia": "node --env-file-if-exists=.env scripts/probar-ia.mjs",
    "i18n": "node scripts/i18n.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0"
  }
}
