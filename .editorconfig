# Estilo básico compartido por los editores (VS Code necesita la extensión
# EditorConfig, recomendada en .vscode/extensions.json). Sin Prettier: el repo
# no se reformatea entero, cada archivo conserva su estilo.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# En Markdown, dos espacios al final de la línea son un salto de línea.
[*.md]
trim_trailing_whitespace = false
